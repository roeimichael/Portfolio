# Copy to .env and edit. EVERYTHING here has a safe default — with NO .env at all
# the system runs in paper mode, free, no external calls. Fill in to go live.

# ---- mode ----
MODE=paper                 # paper = simulated/free | live = real adapters
DB_PATH=dropship.db
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# ---- authority dials (the Guardrail enforces these; start conservative) ----
PER_ORDER_CAP=40
DAILY_CAP=200
REFUND_CEILING=25
SUPERVISOR_AUTHORITY=100
PRICE_BAND_LOW=2.2
PRICE_BAND_HIGH=3.5
AUTO_PUBLISH=false
WALLET_START=500           # bounded money-out balance (simulated hard card cap)

# ---- agent brains (optional) ----
# Leave USE_LLM=false to run on free deterministic heuristics. Flip on to let
# Claude make the judgment calls at each decision joint.
USE_LLM=false
# ANTHROPIC_API_KEY=sk-ant-...
BRAIN_MODEL=claude-haiku-4-5-20251001

# ---- live adapter credentials (only needed when MODE=live) ----
# SHOPIFY_STORE=yourstore.myshopify.com
# SHOPIFY_TOKEN=shpat_...
# SUPPLIER=printify
# PRINTIFY_TOKEN=...
# PRINTIFY_SHOP_ID=...
# AFTERSHIP_TOKEN=...
# POSTMARK_TOKEN=...
# FROM_EMAIL=support@yourdomain.com

# ---- timing ----
TICK_SEC=2
SIM_STAGE_TICKS=2
